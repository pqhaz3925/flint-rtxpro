+// Fused amax rescale (build_amax_src1_f16): for each row of x
+//   e = exp(s7 * clamp(ceil(s4 * log(s2 * max|x| + b2) + b4), lo, hi) + b7),  y = x / e
+// Same float ops in the same order as the unfused graph, so results are bit-identical.
+static __global__ void amax_rescale_kernel(const float * x, float * e_out, float * y, const int iw, const int nr,
+        const float s2, const float b2, const float s4, const float b4, const float lo, const float hi, const float s7, const float b7) {
+    const int row = blockIdx.x * (blockDim.x / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+    if (row >= nr) {
+        return;
+    }
+    const int lane = threadIdx.x % WARP_SIZE;
+    const float * xr = x + (int64_t) row * iw;
+    float amax = -FLT_MAX;
+    for (int i = lane; i < iw; i += WARP_SIZE) {
+        amax = fmaxf(amax, fabsf(__ldg(xr + i)));
+    }
+    amax = warp_reduce_max(amax);
+    float e = s2 * amax + b2;
+    e = logf(e);
+    e = s4 * e + b4;
+    e = ceilf(e);
+    e = fminf(fmaxf(e, lo), hi);
+    e = s7 * e + b7;
+    e = expf(e);
+    if (lane == 0) {
+        e_out[row] = e;
+    }
+    float * yr = y + (int64_t) row * iw;
+    for (int i = lane; i < iw; i += WARP_SIZE) {
+        yr[i] = xr[i] / e;
+    }
+}
