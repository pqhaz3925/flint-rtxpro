+// amax rescale chain from llm_graph_context::build_amax_src1_f16 (fused into one kernel by CUDA)
+struct test_amax_rescale : public test_case {
+    const std::array<int64_t, 4> ne;
+    const float x_scale;
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "AMAX_RESCALE";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    std::string vars() override {
+        return VARS_TO_STR2(ne, x_scale);
+    }
+
+    test_amax_rescale(std::array<int64_t, 4> ne = {512, 6, 1, 1}, float x_scale = 1e5f)
+        : ne(ne), x_scale(x_scale) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_set_name(a, "a");
+
+        // per-row magnitudes from 0 to x_scale, so the power-of-two exponent varies between rows (incl. the clamp at 0)
+        ggml_tensor * r = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, ne[1], ne[2], ne[3]);
+        ggml_set_name(r, "r");
+
+        // x is an intermediate result, so the allocator may place the DIV in-place over it, as in the model graph
+        ggml_tensor * x = ggml_mul(ctx, a, ggml_scale(ctx, r, x_scale));
+        ggml_set_name(x, "x");
+
+        ggml_tensor * amax = ggml_pool_1d(ctx, ggml_abs(ctx, x), GGML_OP_POOL_MAX, ne[0], ne[0], 0);
+
+        ggml_tensor * e = ggml_scale(ctx, amax, 1.0f/1024.0f);
+        e = ggml_log  (ctx, e);
+        e = ggml_scale(ctx, e, 1.4426950408889634f);
+        e = ggml_ceil (ctx, e);
+        e = ggml_clamp(ctx, e, 0.0f, 127.0f);
+        e = ggml_scale(ctx, e, 0.6931471805599453f);
+        e = ggml_exp  (ctx, e);
+
+        // both results are used afterwards; adding e keeps a wrong scale visible
+        ggml_tensor * out = ggml_add(ctx, ggml_div(ctx, x, e), e);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
