diff --git a/ggml/src/ggml-cuda/pool1d.cu b/ggml/src/ggml-cuda/pool1d.cu
index ac6fb0c..391fb0d 100644
--- a/ggml/src/ggml-cuda/pool1d.cu
+++ b/ggml/src/ggml-cuda/pool1d.cu
@@ -49,6 +49,29 @@ static __global__ void pool1d_nchw_kernel(
     o_ptr[cur_ow] = res;
 }
 
+// one warp per row: pooling window covers the whole row (OW == 1, no padding)
+static __global__ void pool1d_row_kernel(const int iw, const int nr, const float * src, float * dst, const enum ggml_op_pool op) {
+    const int row = blockIdx.x * (blockDim.x / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+    if (row >= nr) {
+        return;
+    }
+    const int lane = threadIdx.x % WARP_SIZE;
+    const float * i_ptr = src + (int64_t) row * iw;
+    float res = op == GGML_OP_POOL_MAX ? -FLT_MAX : 0.0f;
+    for (int i = lane; i < iw; i += WARP_SIZE) {
+        const float cur = __ldg(i_ptr + i);
+        res = op == GGML_OP_POOL_MAX ? fmaxf(res, cur) : res + cur;
+    }
+    if (op == GGML_OP_POOL_MAX) {
+        res = warp_reduce_max(res);
+    } else {
+        res = warp_reduce_sum(res) / iw;
+    }
+    if (lane == 0) {
+        dst[row] = res;
+    }
+}
+
 static void pool1d_nchw_kernel_f32_f32_cuda(
         const int iw, const int ow,
         const int kw, const int sw, const int pw,
@@ -81,5 +104,61 @@ void ggml_cuda_op_pool1d(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
 
     const int parallel_elements = (int)(nr * OW);
 
+    if (OW == 1 && p0 == 0 && k0 >= IW && IW > 0 && (op == GGML_OP_POOL_MAX || op == GGML_OP_POOL_AVG)) {
+        const int rows_per_block = 4;
+        const int nb = (int)((nr + rows_per_block - 1) / rows_per_block);
+        pool1d_row_kernel<<<nb, rows_per_block * WARP_SIZE, 0, stream>>>((int) IW, (int) nr, src0_d, dst_d, op);
+        return;
+    }
+
     pool1d_nchw_kernel_f32_f32_cuda(IW, OW, k0, s0, p0, parallel_elements, src0_d, dst_d, op, stream);
 }
+
+
+// Fused amax rescale (build_amax_src1_f16): for each row of x
+//   e = exp(s7 * clamp(ceil(s4 * log(s2 * max|x| + b2) + b4), lo, hi) + b7),  y = x / e
+// Same float ops in the same order as the unfused graph, so results are bit-identical.
+static __global__ void amax_rescale_kernel(const float * x, float * e_out, float * y, const int iw, const int nr,
+        const float s2, const float b2, const float s4, const float b4, const float lo, const float hi, const float s7, const float b7) {
+    const int row = blockIdx.x * (blockDim.x / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+    if (row >= nr) {
+        return;
+    }
+    const int lane = threadIdx.x % WARP_SIZE;
+    const float * xr = x + (int64_t) row * iw;
+    float amax = -FLT_MAX;
+    for (int i = lane; i < iw; i += WARP_SIZE) {
+        amax = fmaxf(amax, fabsf(__ldg(xr + i)));
+    }
+    amax = warp_reduce_max(amax);
+    float e = s2 * amax + b2;
+    e = logf(e);
+    e = s4 * e + b4;
+    e = ceilf(e);
+    e = fminf(fmaxf(e, lo), hi);
+    e = s7 * e + b7;
+    e = expf(e);
+    if (lane == 0) {
+        e_out[row] = e;
+    }
+    float * yr = y + (int64_t) row * iw;
+    for (int i = lane; i < iw; i += WARP_SIZE) {
+        yr[i] = xr[i] / e;
+    }
+}
+
+void ggml_cuda_op_amax_rescale(ggml_backend_cuda_context & ctx, ggml_tensor ** n) {
+    const ggml_tensor * x = n[0]->src[0];
+    ggml_tensor * e_t = n[8];
+    ggml_tensor * y   = n[9];
+    const int iw = (int) x->ne[0];
+    const int nr = (int) ggml_nrows(x);
+    const int rows_per_block = 4;
+    const int nb = (nr + rows_per_block - 1) / rows_per_block;
+    amax_rescale_kernel<<<nb, rows_per_block * WARP_SIZE, 0, ctx.stream()>>>(
+        (const float *) x->data, (float *) e_t->data, (float *) y->data, iw, nr,
+        ggml_get_op_params_f32(n[2], 0), ggml_get_op_params_f32(n[2], 1),
+        ggml_get_op_params_f32(n[4], 0), ggml_get_op_params_f32(n[4], 1),
+        ggml_get_op_params_f32(n[6], 0), ggml_get_op_params_f32(n[6], 1),
+        ggml_get_op_params_f32(n[7], 0), ggml_get_op_params_f32(n[7], 1));
+}
